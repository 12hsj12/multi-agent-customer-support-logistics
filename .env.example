# Required: replace with a valid Anthropic-compatible API key.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Set a unique random value before starting Compose.
REDIS_PASSWORD=replace-with-a-unique-random-password

# Keep the original intent path by default. Set to local to enable the
# in-process Mapika Decider GGUF provider.
ECHOMIND_DECISION_BACKEND=baseline
ECHOMIND_LOCAL_DECISION_PROVIDER=mapika_gguf
ECHOMIND_DECIDER_MODEL_PATH=./models/decider-2b-v11-Q4_K_M.gguf
ECHOMIND_DECIDER_N_CTX=2048
ECHOMIND_DECIDER_N_THREADS=6
ECHOMIND_DECISION_TRIGGER_CONFIDENCE=0.65
ECHOMIND_LLM_PRIORITY_CONFIDENCE=0.85

# Optional OpenJev-compatible HTTP provider; select it explicitly above.
ECHOMIND_OPENJEV_BASE_URL=
ECHOMIND_OPENJEV_API_KEY=
ECHOMIND_OPENJEV_TIMEOUT_SECONDS=8

# Example logistics handoff thresholds used by the local mock flow.
ECHOMIND_LOGISTICS_LOST_DAYS_THRESHOLD=7
ECHOMIND_LOGISTICS_MIN_FOLLOWUPS=2
