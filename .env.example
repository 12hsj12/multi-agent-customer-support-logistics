# Required: replace with a valid Anthropic-compatible API key.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Set a unique random value before starting Compose.
REDIS_PASSWORD=replace-with-a-unique-random-password

# Use the independent OpenJev oneshot service when eligible for arbitration.
# The existing high-confidence baseline priority and failure fallback remain.
ECHOMIND_DECISION_BACKEND=local
ECHOMIND_LOCAL_DECISION_PROVIDER=openjev_http
ECHOMIND_DECIDER_MODEL_PATH=./models/decider-2b-v11-Q4_K_M.gguf
ECHOMIND_DECIDER_N_CTX=2048
ECHOMIND_DECIDER_N_THREADS=6
ECHOMIND_DECISION_TRIGGER_CONFIDENCE=0.65
ECHOMIND_LLM_PRIORITY_CONFIDENCE=0.85

# OpenJev is internal to Docker Compose; its OpenAI-compatible model credential
# lives in the ignored .env.openjev file and is passed only to that service.
ECHOMIND_OPENJEV_BASE_URL=http://openjev:3001
ECHOMIND_OPENJEV_TIMEOUT_SECONDS=8
OPENJEV_MODEL=deepseek-flash
OPENJEV_MODE=oneshot
OPENJEV_DECIDER_BASE_URL=http://decider:8000

# Reserved official TypeSafe adapter. Leave blank until an official API key is
# available; it is not the selected backend and is tested only with mock data.
ECHOMIND_OFFICIAL_JEV_BASE_URL=https://api.typesafe.ai
ECHOMIND_OFFICIAL_JEV_MODEL=jev-latest
ECHOMIND_OFFICIAL_JEV_API_KEY=
ECHOMIND_OFFICIAL_JEV_TIMEOUT_SECONDS=8

# Example logistics handoff thresholds used by the local mock flow.
ECHOMIND_LOGISTICS_LOST_DAYS_THRESHOLD=7
ECHOMIND_LOGISTICS_MIN_FOLLOWUPS=2
