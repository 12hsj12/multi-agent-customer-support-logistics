# Local OpenJev service credentials. The ignored .env.openjev file is separate
# from EchoMind's .env; these values are passed only to the OpenJev container.
OPENAI_API_KEY=replace-with-an-openai-compatible-model-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENJEV_MODEL=deepseek-flash
# Optional only when using OPENJEV_MODE=decider with a secured downstream server.
DECIDER_API_KEY=
